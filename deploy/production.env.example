# docker-compose.prod.yml değişkenleri → proje kökünde .env olarak kopyalayın
ROOT_DOMAIN=akisb2b.com
ACME_EMAIL=altyapi@akisb2b.com
POSTGRES_USER=akis
POSTGRES_PASSWORD=            # openssl rand -base64 32
POSTGRES_DB=akis_b2b
PLATFORM_NAME=Akis B2B
SUPPORT_PHONE=+90 212 000 00 00
SUPPORT_EMAIL=destek@akisb2b.com
# Yedek: her gün bu saatte (bayilerin çalışmadığı saat); sunucuda BACKUP_KEEP_DAYS gün saklanır
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
# Google Drive'a şifreli kopya (bir kez: scripts/drive-setup.sh): günlükler ve her ayın ilk yedeği bu süre saklanır
BACKUP_DRIVE_KEEP_DAYS=30
BACKUP_DRIVE_KEEP_MONTHS=12
# Yedekten sonra çalışacak ek komut (isteğe bağlı) — bkz. docs/canliya-cikis.md
BACKUP_POST_CMD=

# Platform (developer) girişi CAPTCHA'sı — Cloudflare Turnstile SİTE anahtarı (gizli anahtar backend/.env.production'da)
TURNSTILE_SITEKEY=
