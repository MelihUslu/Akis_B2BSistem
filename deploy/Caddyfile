# Canlı ortam ters vekili ve HTTPS (docker-compose.prod.yml → web servisi)
# - api.ROOT_DOMAIN       → backend (API, yüklenen dosyalar, ödeme geri dönüşleri)
# - diğer tüm alan adları → arayüz (kök, platform, firma alt alan adları, doğrulanmış özel alan adları)
# Sertifikalar ilk istekte otomatik alınır; "ask" yalnızca sistemde kayıtlı alan adlarına izin verir.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://backend:5001/api/public/domain-check
	}
}

api.{$ROOT_DOMAIN} {
	encode zstd gzip
	# Backend'e en fazla 1024 kalıcı bağlantı; boşalanlar kapatılmaz (yoğunlukta yeni bağlantı açılmaz). Ani yük testinde
	# (5 Kasım 2026) sınırsızken yoğunlukta açılan yeni bağlantılar Node cluster'ın devir kuyruğunda 60 sn bekledi.
	# İşçi başına düşen bağlantı (1024 / WEB_CONCURRENCY) backend'in MAX_INFLIGHT eşiğinden (100) büyük kalmalı:
	# fazla istek burada kuyrukta beklemesin, backend'den hemen 503 alsın (middlewares/overload.js).
	reverse_proxy backend:5001 {
		transport http {
			max_conns_per_host 1024
			keepalive_idle_conns_per_host 1024
		}
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	# www.firma.com → firma.com (alan adının tamamı bağlanan firmalar ve kök alan adı)
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	root * /srv

	# Service worker ve index.html önbelleğe alınmaz (yeni sürüm hemen gelsin); derlenmiş dosyalar uzun süre önbellekte
	@nocache path /sw.js /index.html /manifest.webmanifest
	header @nocache Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# PayTR ödeme formu iframe ile açıldığı için frame-src'de izinlidir
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.{$ROOT_DOMAIN}; frame-src https://www.paytr.com https://*.iyzipay.com; manifest-src 'self' blob:; worker-src 'self'; frame-ancestors 'none'"
		-Server
	}
}
