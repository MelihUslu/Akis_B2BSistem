# Canlı backend ayarları → backend/.env.production olarak kopyalayın (docker-compose.prod.yml okur)
# DATABASE_URL, REDIS_URL, NODE_ENV ve PORT compose tarafından verilir.
# Kontrol:  docker compose -f docker-compose.prod.yml run --rm backend npm run check:config

# ── Zorunlu (eksikse sunucu açılmaz) ────────────────────────────────────────
JWT_SECRET=                     # openssl rand -base64 48
ENCRYPTION_KEY=                 # openssl rand -base64 48 — SONRADAN DEĞİŞTİRMEYİN (kayıtlı POS/e-fatura anahtarları çözülemez)
ROOT_DOMAIN=akisb2b.com
FRONTEND_PROTOCOL=https
FRONTEND_PORT=
API_PUBLIC_URL=https://api.akisb2b.com
PUBLIC_URL=https://api.akisb2b.com

# ── İlk kurulum (boş veritabanında platform yöneticisi oluşturulur) ──────────
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=        # en az 12 karakter; ilk girişte değiştirip 2FA açın
PLATFORM_ADMIN_NAME=Platform Yöneticisi
PLATFORM_NAME=Akis B2B
PLATFORM_ALERT_EMAIL=           # yeni hata / destek / ödeme sorunu uyarıları
# İzleme: günlük özet e-postası (08:00), son 10 dk'da bu kadar sunucu hatası olursa uyarı, isteğe bağlı Sentry (npm install @sentry/node)
DAILY_DIGEST=true
DIGEST_HOUR=8
ALERT_ERROR_SPIKE=30
SENTRY_DSN=
SEED_DEMO=false

# ── E-posta (şifre sıfırlama, teklif, ekstre, bildirim) ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Akis B2B <bildirim@akisb2b.com>"

# ── Telefon / masaüstü bildirimi:  npx web-push generate-vapid-keys ─────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@akisb2b.com

# ── Google ile giriş (boşsa düğme görünmez) ─────────────────────────────────
# Google Cloud Console → OAuth istemci kimliği (Web uygulaması);
# yönlendirme URI'si: https://api.akisb2b.com/api/public/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Yapay zekâ ile teklif (boşsa manuel teklif çalışır) ─────────────────────
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=200

# ── Abonelik tahsilatı (iyzico) ve platform faturası (Paraşüt) ──────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=
SUBSCRIPTION_VAT_RATE=20

# ── Diğer ───────────────────────────────────────────────────────────────────
# Performans: işçi süreç sayısı (çekirdek sayısı kadar; 1 = tek süreç) ve süreç başına veritabanı bağlantısı.
# Toplam bağlantı = WEB_CONCURRENCY × DB_POOL_SIZE; PostgreSQL max_connections'ı (varsayılan 100) aşmamalı.
WEB_CONCURRENCY=1
DB_POOL_SIZE=
DB_POOL_TIMEOUT=
CUSTOM_DOMAIN_TARGET=custom.akisb2b.com
# Firmalar alan adının tamamını (firma.com) bağlarken A kaydına yazacakları sunucu IP'si.
# Boşsa CUSTOM_DOMAIN_TARGET adresinin IP'si kullanılır.
CUSTOM_DOMAIN_IP=
AUTO_PURGE_CLOSED=true
TZ=Europe/Istanbul
