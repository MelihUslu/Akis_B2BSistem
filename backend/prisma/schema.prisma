// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int       @id @default(autoincrement())
  tenantId             Int? // SUPER_ADMIN (platform sahibi) için boş
  tenant               Tenant?   @relation(fields: [tenantId], references: [id])
  email                String
  password             String
  name                 String
  role                 String    @default("BAYI") // SUPER_ADMIN (platform), ADMIN (kiracı yöneticisi), BAYI, PLASIYER, PERSONEL (yalnızca Personel Alanım)
  // Firma sahibi (ADMIN) tüm yetkilere sahiptir ve silinemez; bayide ana kullanıcıdır (alt kullanıcı yönetir)
  isOwner              Boolean   @default(false)
  permissions          Json? // ADMIN personeli için: ["CATALOG","ORDERS","DEALERS","FINANCE","SETTINGS"]
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  // İki aşamalı doğrulama (TOTP). Gizli anahtar şifreli; yedek kodların sadece özeti saklanır
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecretEnc   String?
  twoFactorRecovery    Json?
  emailVerifiedAt      DateTime?
  emailVerifyToken     String?   @unique
  // Şifre sıfırlama: bağlantıdaki anahtarın yalnızca SHA-256 özeti saklanır
  passwordResetHash    String?   @unique
  passwordResetExpires DateTime?
  // Bu andan önce verilen oturumlar geçersizdir (şifre değişince tüm cihazlardan çıkış)
  passwordChangedAt    DateTime?
  // E-posta bildirim tercihleri: { ORDER: true, PAYMENT: false, … } (yoksa varsayılanlar)
  notificationPrefs    Json?
  // SMS bildirimi (firmada SMS açıksa): cep telefonu 5XXXXXXXXX biçiminde; tercihler { ORDER: false, … } (yoksa açık)
  phone                String?
  smsPrefs             Json?
  cart                 Json? // Sunucuda saklanan sepet: [{ id, quantity }] (cihazlar arasında taşınır)
  cartUpdatedAt        DateTime?
  companyId            Int?
  company              Company?  @relation(fields: [companyId], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orders            Order[]
  plasiyerPoints    PlasiyerPoint[]
  plasiyerOf        Company[]          @relation("CompanyPlasiyer")
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  stockAlerts       StockAlert[]
  reconciliations   Reconciliation[]
  returnRequests    ReturnRequest[]
  quoteRequests     QuoteRequest[]
  preparedQuotes    QuoteRequest[]     @relation("QuotePreparer")
  ownedPartners     Company[]          @relation("PartnerOwner")
  partnerNotes      PartnerNote[]
  favorites         Favorite[]
  orderTemplates    OrderTemplate[]
  supportTickets    SupportTicket[]
  smsCampaigns      SmsCampaign[]
  mailCampaigns     MailCampaign[]
  employee          Employee?          @relation("EmployeeUser")

  @@index([tenantId])
}

// Cari hesap. kind: DEALER (portala giren bayi), CUSTOMER (portal dışı müşteri, ara sıra alışveriş), SUPPLIER (tedarikçi).
// Bayi ekranları yalnızca DEALER kayıtlarını gösterir; diğer türler "Cari Hesaplar" ekranından yönetilir.
model Company {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  kind             String   @default("DEALER")
  name             String
  taxNumber        String?
  taxOffice        String?
  authorizedPerson String?
  phone            String?
  address          String?
  status           String   @default("PENDING") // PENDING, ACTIVE, PASSIVE
  externalCode     String? // ERP cari kodu
  source           String   @default("ADMIN") // ADMIN (admin ekledi), APPLICATION (bayi başvurusu)
  applicationNote  String? // Başvuru formundaki mesaj
  email            String? // Carinin genel e-postası (bayide giriş e-postası kullanıcıdadır)
  notes            String? // İç not (cariye gösterilmez)
  tags             String[] @default([]) // Serbest etiketler: "İstanbul", "Toptan", "Takipte"…
  ownerId          Int? // Cariden sorumlu personel
  owner            User?    @relation("PartnerOwner", fields: [ownerId], references: [id])
  // Cari para birimi: TRY, USD, EUR. Bakiye, risk limiti ve hareket tutarları bu para birimindedir.
  // Hareket oluştuktan sonra değiştirilemez.
  currency         String   @default("TRY")
  riskLimit        Float    @default(0) // Risk Limiti (Açık hesap limiti, cari para biriminde)
  currentBalance   Float    @default(0) // Güncel Bakiye (cari para biriminde; alacaklıysa artı, borçluysa eksi)
  dealerGroup      String   @default("STANDART") // Bayi Grubu: STANDART, GOLD, VIP
  netDiscount      Float    @default(0) // Net İskonto (%)
  minOrderAmount   Float    @default(0) // Sepet Alt Limiti
  paymentTermDays  Int      @default(30) // Vade (gün)
  plasiyerId       Int? // Bayiden sorumlu plasiyer (prim için)
  plasiyer         User?    @relation("CompanyPlasiyer", fields: [plasiyerId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users           User[]
  addresses       DeliveryAddress[]
  orders          Order[]
  transactions    FinancialTransaction[]
  payments        Payment[]
  reconciliations Reconciliation[]
  returnRequests  ReturnRequest[]
  specialPrices   SpecialPrice[]
  coupons         Coupon[]
  quoteRequests   QuoteRequest[]
  orderTemplates  OrderTemplate[]
  contacts        CompanyContact[]
  partnerNotes    PartnerNote[]
  documents       PartnerDocument[]
  statementLinks  StatementRequest[]
  targets         DealerTarget[]

  @@unique([tenantId, taxNumber])
  @@unique([tenantId, externalCode])
  @@index([tenantId])
  @@index([tenantId, kind])
}

// Cari görüşme notları ve hatırlatmalar ("Aradım, cuma ödeyecek" — hatırlatma tarihinde yazan kişiye bildirim gider)
model PartnerNote {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id])
  body       String
  remindAt   DateTime?
  notifiedAt DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([companyId])
  @@index([tenantId, remindAt])
}

// Cari belgeleri (vergi levhası, sözleşme, imza sirküleri…). Dosya herkese açık klasörde değil, yetkiyle indirilir.
model PartnerDocument {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  storedName String
  mimeType   String
  size       Int
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([companyId])
}

// Ekstre paylaşım bağlantısı ve mutabakat isteği (portal kullanmayan cariler için de)
model StatementRequest {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  balance       Float // Gönderildiği andaki bakiye (mutabakat bu bakiye için)
  periodEnd     DateTime
  sentTo        String?
  emailed       Boolean   @default(false)
  createdByName String?
  expiresAt     DateTime
  response      String? // AGREED, DISPUTED
  responseNote  String?
  responderName String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([companyId])
}

// Carinin yetkili kişileri (satın alma, muhasebe, depo…)
model CompanyContact {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  title     String? // Görevi
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([companyId])
}

model Category {
  id            Int        @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  name          String
  imageUrl      String?
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  parentId      Int?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  visibleGroups String[]   @default([]) // Boşsa tüm bayiler; doluysa yalnızca bu gruplar (alt kategoriler de gizlenir)
  children      Category[] @relation("CategoryHierarchy")
  products      Product[]

  @@index([tenantId])
}

model Product {
  id        Int     @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  name      String
  brand     String? // Marka
  sku       String
  barcode   String?
  shortDesc String? // Kısa Açıklama
  longDesc  String? // Detaylı Açıklama (HTML)

  // Fiyatlandırma
  price     Float // Liste Fiyatı
  costPrice Float? // Maliyet Fiyatı (Sadece Admin)
  currency  String @default("TRY") // TRY, USD, EUR
  vatRate   Float  @default(20) // KDV Oranı (1, 10, 20)

  // Stok ve Operasyonel
  stock        Int     @default(0)
  unit         String  @default("Adet") // Adet, Kutu, Koli, Metre, Kg
  moq          Int     @default(1) // Minimum Sipariş Miktarı
  stepQuantity Int     @default(1) // Artış Katsayısı
  // Paket dönüşümü (tanımlıysa): 1 packUnit = packSize × unit (örn. 1 Koli = 50 Adet). Teklifte birim çevirisi yalnızca buna göre yapılır.
  packUnit     String?
  packSize     Int?

  // Medya
  images   String? // JSON stringified image array
  pdfUrl   String? // Teknik Katalog PDF
  videoUrl String? // YouTube Video Link

  // Hiyerarşi
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Varyant Yönetimi (Self-relation)
  isMaster Boolean   @default(true) // Ana ürün mü varyant mı?
  parentId Int?
  parent   Product?  @relation("ProductVariants", fields: [parentId], references: [id])
  variants Product[] @relation("ProductVariants")

  // Alternatif/Muadil Ürün İlişkisi
  alternativeToId Int?
  alternativeTo   Product?  @relation("AlternativeProducts", fields: [alternativeToId], references: [id])
  alternatives    Product[] @relation("AlternativeProducts")

  hidePrice     Boolean  @default(false) // Fiyat gizlensin mi?
  visibleGroups String[] @default([]) // Boşsa tüm bayiler görür; doluysa yalnızca bu bayi grupları (varyantlar ana üründen alır)
  isActive      Boolean  @default(true) // Ürün aktif mi?
  sortOrder     Int      @default(0) // Sıralama önceliği
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems      OrderItem[]
  stockAlerts     StockAlert[]
  warehouseStocks WarehouseStock[]
  returnRequests  ReturnRequest[]
  // Özel varyant tanımı: ana üründe özellikler (Gramaj, Ambalaj...), varyantta seçilen değerler
  options         ProductOption[]
  variantValues   ProductVariantValue[]
  specialPrices   SpecialPrice[]
  favorites       Favorite[]
  quoteItems      QuoteRequestItem[]
  // Birlikte kullanılabilen ürünler (örn. bardak ↔ kapak). İlişki iki yönlüdür; tek satır yeterlidir.
  compatibleWith  ProductCompatibility[] @relation("CompatFrom")
  compatibleOf    ProductCompatibility[] @relation("CompatTo")

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([parentId])
  // Katalog varsayılan sıralaması: ilk sayfa tablo taranmadan bulunur
  @@index([tenantId, sortOrder, createdAt(sort: Desc)])
  // Katalog araması (ad, stok kodu, barkod, marka içinde geçen; büyük/küçük harf duyarsız): pg_trgm
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([barcode(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([brand(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Order {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id])
  subtotal       Float     @default(0) // KDV hariç net tutar
  vatAmount      Float     @default(0)
  totalAmount    Float // KDV dahil genel toplam
  debitedAmount  Float     @default(0) // Cariye borç olarak yazılmış tutar (yeniden onayda fark alınır)
  paymentMethod  String? // CURRENT_ACCOUNT, WIRE_TRANSFER
  approvedAt     DateTime?
  shippedAt      DateTime?
  dueDate        DateTime? // Ödeme vadesi (onay tarihi + bayi vadesi)
  status         String    @default("PENDING") // PENDING, PARTIAL_APPROVED, APPROVED, SHIPPED, READY_FOR_PICKUP (Gel-Al), COMPLETED, CANCELLED
  deliveryMethod String    @default("SHIPPING") // SHIPPING (kargo / teslimat adresi), PICKUP (Gel-Al: bayi depodan teslim alır)
  pickupAt       DateTime? // Gel-Al: bayinin seçtiği teslim alma zamanı
  readyAt        DateTime? // Gel-Al: "Teslim almaya hazır" yapıldığı an
  trackingNumber String? // Kargo Takip No
  cargoCompany   String? // YURTICI, ARAS, MNG, PTT, UPS, SURAT, DHL, DIGER
  exportedAt     DateTime? // ERP'ye aktarıldığı an (Entegrasyon API)
  fxRates        Json? // Sipariş anındaki kurlar { USD, EUR } — dövizli cariye bu kurla işlenir
  // Kupon (parçalı onayda indirim yeniden hesaplanabilsin diye kuralı saklanır)
  couponCode     String?
  couponType     String? // PERCENT, AMOUNT
  couponValue    Float?
  discountAmount Float     @default(0) // KDV hariç kupon indirimi
  note           String? // Bayinin sipariş notu ("Pazartesi teslim olsun")
  customerRef    String? // Bayinin kendi sipariş / satın alma numarası
  shippingFee    Float     @default(0) // Kargo ücreti (KDV hariç); toplam tutara dahildir
  shippingVat    Float     @default(0) // Kargo ücretinin KDV'si
  channel        String    @default("PORTAL") // PORTAL (bayi), STAFF (yönetici bayi adına), PLASIYER (plasiyer bayi adına), QUOTE (tekliften)
  autoApproved   Boolean   @default(false) // Otomatik onay kuralıyla onaylandı
  cancelledAt    DateTime?
  cancelledBy    String? // DEALER (bayi iptal etti), ADMIN (yönetici kararı)
  despatchNumber String? // İrsaliye numarası (ERP'den / elle)
  despatchDate   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoice          Invoice?
  shipments        OrderShipment[]
  warehouseId      Int? // Siparişi karşılayan depo (depo tanımlıysa)
  warehouse        Warehouse?             @relation(fields: [warehouseId], references: [id])
  shippingAddress  Json? // Sipariş anındaki teslimat adresi: { title, contactName, phone, city, district, line, postalCode }
  // Kargo entegrasyonu: gönderi anahtarı (AK{id}), firmanın kargo sisteminde oluşturuldu mu, son durum
  shipmentProvider String?
  shipmentKey      String?
  shipmentStatus   String? // CREATED, IN_TRANSIT, DELIVERED, CANCELLED, ERROR
  shipmentInfo     String? // kargo firmasının son durum açıklaması / hata mesajı
  shipmentSyncedAt DateTime?
  items            OrderItem[]
  payments         Payment[]
  plasiyerPoint    PlasiyerPoint?
  transactions     FinancialTransaction[]
  returnRequests   ReturnRequest[]
  quoteRequest     QuoteRequest?

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  // Bekleyen tutar ve en eski bekleyen sipariş yalnızca indeksten okunur. Durum sayaçları dar indeksi kullanır:
  // yalnızca bu geniş indeks olunca planlayıcı tabloyu taramayı seçiyor, yük altında sayaçlar 1,3 sn sürüyordu.
  @@index([tenantId, status, createdAt, totalAmount])
  @@index([companyId, createdAt])
}

// Firmanın depoları. Depo tanımlıysa ürün stoku depo bazında tutulur; Product.stock tüm depoların toplamıdır.
model Warehouse {
  id        Int              @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  name      String
  code      String // ERP eşleştirmesi için kısa kod (ör. IST, ANK)
  city      String?
  isDefault Boolean          @default(false)
  createdAt DateTime         @default(now())
  stocks    WarehouseStock[]
  orders    Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model WarehouseStock {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int       @default(0)

  @@unique([warehouseId, productId])
  @@index([tenantId])
  @@index([productId])
}

// Bayinin teslimat adresleri (şube, depo…). Siparişte seçilen adres siparişe kopyalanır.
model DeliveryAddress {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  title       String // "Merkez depo", "Ankara şube"
  contactName String
  phone       String
  city        String
  district    String
  line        String // mahalle, cadde, no…
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([companyId])
}

// Siparişin faturası (bir sipariş = bir fatura)
model Invoice {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  orderId      Int       @unique
  order        Order     @relation(fields: [orderId], references: [id])
  provider     String // PARASUT, ERP, MANUAL
  status       String    @default("PENDING") // PENDING, ISSUED, FAILED
  documentType String? // E_FATURA, E_ARSIV, KAGIT
  number       String?
  externalId   String? // Sağlayıcıdaki fatura kaydı (Paraşüt sales_invoice id)
  pdfUrl       String? // ERP / elle yüklenen PDF; Paraşüt'te PDF istendiğinde alınır
  amount       Float?
  errorMessage String?
  issuedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

model OrderItem {
  id               Int     @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant  @relation(fields: [tenantId], references: [id])
  orderId          Int
  order            Order   @relation(fields: [orderId], references: [id])
  productId        Int
  product          Product @relation(fields: [productId], references: [id])
  quantity         Int
  price            Float // Birim net fiyat (TL, iskontolar sonrası, KDV hariç)
  vatRate          Float   @default(20)
  status           String  @default("APPROVED") // APPROVED, CANCELLED (Parçalı onay için iptal edilen kalemleri işaretlemek amaçlı)
  isStockDeducted  Boolean @default(false)
  stockWarehouseId Int? // Stok hangi depodan düşüldü (iptal / iadede oraya geri döner)
  variantLabel     String? // Sipariş anındaki varyant seçimi, örn. "Gramaj: 1 kg · Ambalaj: Kutu"
  shippedQty       Int     @default(0) // Kısmi sevkiyat: kargoya verilen miktar

  returnRequests ReturnRequest[]

  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            Int                    @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  orderId       Int?
  order         Order?                 @relation(fields: [orderId], references: [id])
  companyId     Int?
  company       Company?               @relation(fields: [companyId], references: [id])
  amount        Float
  method        String                 @default("POS") // POS (sanal POS), WIRE_TRANSFER, CASH, CARD (fiziki POS), CHECK (çek), NOTE (senet), MANUAL
  direction     String                 @default("IN") // IN: cariden tahsilat, OUT: cariye (tedarikçiye) ödeme
  currency      String                 @default("TRY") // Ödenen paranın birimi (amount bu birimde)
  rate          Float                  @default(1) // Carinin dövizi için kullanılan kur (1 birim = rate TL)
  accountAmount Float? // Cariye işlenen tutar (cari para biriminde)
  receiptNo     Int? // Firma içinde sıralı makbuz numarası (elle girilen tahsilat / ödemelerde)
  bankName      String? // Havale bankası / çekin bankası
  dueDate       DateTime? // Çek / senet vadesi
  note          String?
  createdByName String?
  cardLast4     String? // Sadece son 4 hane saklanır
  reference     String? // Provizyon / referans no
  paymentDate   DateTime               @default(now())
  status        String                 @default("COMPLETED")
  provider      String? // IYZICO
  token         String?                @unique // Ödeme formu token'ı (dönüşte doğrulama)
  userId        Int?
  transactions  FinancialTransaction[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId])
}

model FinancialTransaction {
  id            Int                   @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  companyId     Int
  company       Company               @relation(fields: [companyId], references: [id])
  type          String // DEBT (Borçlandırma), CREDIT (Alacaklandırma)
  amount        Float // Cari para biriminde
  currency      String                @default("TRY") // Carinin para birimi (hareket anında)
  rate          Float                 @default(1) // 1 birim cari dövizi = rate TL (TL caride 1)
  amountTRY     Float? // Hareketin TL karşılığı (kur farkı hesabı için)
  description   String?
  orderId       Int?
  order         Order?                @relation(fields: [orderId], references: [id])
  date          DateTime              @default(now())
  // Hareketin kaynağı: ORDER (sipariş onayı/düzeltme), RETURN (iade), PAYMENT (tahsilat/ödeme), ERP, OPENING (açılış), MANUAL, REVERSAL (ters kayıt)
  source        String                @default("MANUAL")
  paymentId     Int?
  payment       Payment?              @relation(fields: [paymentId], references: [id])
  // Ters kayıt: yanlış girilen hareket silinmez, karşı kayıtla düzeltilir
  reversalOfId  Int?                  @unique
  reversalOf    FinancialTransaction? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy    FinancialTransaction? @relation("Reversal")
  createdByName String?

  @@index([tenantId])
  @@index([companyId, date])
}

model PlasiyerPoint {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    Int // Plasiyer rolündeki kullanıcının ID'si
  user      User     @relation(fields: [userId], references: [id])
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id])
  points    Float // Kazanılan prim puanı
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Setting {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  key      String
  value    String

  @@unique([tenantId, key])
}

// Bayinin cari ekstresini onaylaması ("Mutabıkım")
model Reconciliation {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  userId        Int? // Portal kullanıcısı; bağlantıyla verilen mutabakatta boş
  user          User?    @relation(fields: [userId], references: [id])
  responderName String? // Bağlantıyla yanıt verenin adı
  balance       Float // Onaylandığı andaki bakiye
  periodEnd     DateTime // Ekstrenin kapsadığı son tarih
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

// İade / Değişim (RMA) talepleri
model ReturnRequest {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id])
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  type        String    @default("RETURN") // RETURN (İade), EXCHANGE (Değişim)
  reason      String
  photos      String? // JSON stringified URL array
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  adminNote   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
}

// Uygulama içi bildirimler
// Telefona / masaüstüne push bildirimi için tarayıcı aboneliği (kurulan uygulama kapalıyken de bildirim gelir)
model PushSubscription {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String // ORDER, PAYMENT_DUE, STOCK, RETURN, PAYMENT, SYSTEM
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  dedupeKey String?  @unique // Aynı bildirimin tekrar gönderilmesini engeller
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([tenantId])
  @@index([createdAt])
}

// "Gelince Haber Ver" talepleri
model StockAlert {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  productId  Int
  product    Product   @relation(fields: [productId], references: [id])
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, productId])
  @@index([tenantId])
}

// ─── SaaS / Platform katmanı ────────────────────────────────────────────────

// Abonelik paketleri (platform sahibi yönetir)
model Plan {
  id                   Int      @id @default(autoincrement())
  code                 String   @unique // STARTER, PRO, ENTERPRISE
  name                 String
  description          String?
  priceMonthly         Float // KDV dahil, TRY
  priceYearly          Float
  maxDealers           Int // -1 = sınırsız
  maxProducts          Int
  maxAdmins            Int
  allowCustomDomain    Boolean  @default(false) // Firmaya özel alan adı (ücretli özellik)
  trialDays            Int      @default(14)
  isActive             Boolean  @default(true)
  isPublic             Boolean  @default(true) // Kayıt sayfasında gösterilsin mi
  sortOrder            Int      @default(0)
  // iyzico abonelik ürün/plan referansları (Platform panelinden senkronize edilir)
  iyzicoProductRef     String?
  iyzicoMonthlyPlanRef String?
  iyzicoYearlyPlanRef  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenants Tenant[]
}

// Kiracı = platformdan abonelik satın alan müşteri firma
model Tenant {
  id                     Int               @id @default(autoincrement())
  slug                   String            @unique // Alt alan adı: <slug>.alanadi.com
  name                   String
  contactEmail           String
  phone                  String?
  taxNumber              String?
  taxOffice              String?
  address                String?
  logoUrl                String?
  status                 String            @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, SUSPENDED, CANCELLED
  planId                 Int
  plan                   Plan              @relation(fields: [planId], references: [id])
  billingCycle           String            @default("MONTHLY") // MONTHLY, YEARLY
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean           @default(false) // İptal edildi, dönem sonuna kadar açık
  signupSource           String            @default("PLATFORM") // PLATFORM (sen açtın), SELF (kendi kayıt oldu)
  signupUtm              Json? // Kayıt sırasındaki reklam kaynağı (utm_source, utm_campaign…)
  notes                  String? // Platform sahibinin iç notları
  // iyzico abonelik bilgileri
  iyzicoCustomerRef      String?
  iyzicoSubscriptionRef  String?           @unique
  iyzicoCheckoutToken    String?           @unique // Başlatılan ödeme formu; geri dönüşte bu kiracıya ait olduğu doğrulanır
  // Firmanın bayilerinden tahsilat için kendi sanal POS'u (gizli anahtar şifreli saklanır)
  posProvider            String? // IYZICO
  posMode                String            @default("SANDBOX") // SANDBOX, LIVE
  posApiKey              String?
  posSecretEnc           String?
  // E-fatura: PARASUT (otomatik) veya boş (ERP'den / elle numara girilir). Anahtarlar şifreli JSON.
  invoiceProvider        String?
  invoiceConfigEnc       String?
  invoiceAutoOn          String            @default("MANUAL") // MANUAL, APPROVED, SHIPPED: fatura otomatik ne zaman kesilir
  invoices               Invoice[]
  // Kargo entegrasyonu (YURTICI). Anahtarlar şifreli JSON.
  cargoProvider          String?
  cargoMode              String            @default("TEST") // TEST, LIVE
  cargoConfigEnc         String?
  // SMS bildirimi (NETGSM): firma kendi hesabını bağlar, istediğinde kapatır (ayarlar silinmez). Bilgiler şifreli JSON.
  smsEnabled             Boolean           @default(false)
  smsProvider            String?
  smsConfigEnc           String?
  smsTypes               Json? // SMS ile gidecek bildirimler: { dealer: ['ORDER', …], staff: ['ORDER'] }
  deliveryAddresses      DeliveryAddress[]
  warehouses             Warehouse[]
  warehouseStocks        WarehouseStock[]
  webhookDeliveries      WebhookDelivery[]
  // Firmaya özel alan adı (örn. b2b.firmasi.com) — DNS TXT kaydı ile doğrulanır
  customDomain           String?           @unique
  customDomainToken      String?
  customDomainVerifiedAt DateTime?
  customDomainApex       Boolean           @default(false) // true: alan adının tamamı (firma.com + www), false: alt alan adı (b2b.firma.com)
  // Hesap kapatma (KVKK): kapatma talebinden 30 gün sonra kalıcı silinebilir
  closedAt               DateTime?
  deletionScheduledAt    DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  users                  User[]
  companies              Company[]
  categories             Category[]
  products               Product[]
  orders                 Order[]
  orderItems             OrderItem[]
  payments               Payment[]
  transactions           FinancialTransaction[]
  plasiyerPoints         PlasiyerPoint[]
  settings               Setting[]
  reconciliations        Reconciliation[]
  returnRequests         ReturnRequest[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  stockAlerts            StockAlert[]
  subscriptionPayments   SubscriptionPayment[]
  productOptions         ProductOption[]
  productOptionValues    ProductOptionValue[]
  productVariantValues   ProductVariantValue[]
  specialPrices          SpecialPrice[]
  coupons                Coupon[]
  quoteRequests          QuoteRequest[]
  quoteRequestItems      QuoteRequestItem[]
  quoteRevisions         QuoteRevision[]
  productCompatibilities ProductCompatibility[]
  companyContacts        CompanyContact[]
  favorites              Favorite[]
  orderTemplates         OrderTemplate[]
  apiKeys                ApiKey[]
  webhooks               Webhook[]
  supportTickets         SupportTicket[]
  supportMessages        SupportMessage[]
  PartnerNote            PartnerNote[]
  PartnerDocument        PartnerDocument[]
  StatementRequest       StatementRequest[]
  customerLeads          CustomerLead[]
  whatsappChannel        WhatsappChannel?
  waConversations        WaConversation[]
  waMessages             WaMessage[]
  periodicReports        PeriodicReport[]
  cashEntries            CashEntry[]
  cashRecurrings         CashRecurring[]
  transferNotices        TransferNotice[]
  orderShipments         OrderShipment[]
  dealerTargets          DealerTarget[]
  employees              Employee[]
  leaveRequests          LeaveRequest[]
  staffClaims            StaffClaim[]
  staffTargets           StaffTarget[]
  staffAnnouncements     StaffAnnouncement[]
  staffPayments          StaffPayment[]
  smsCampaigns           SmsCampaign[]
  mailCampaigns          MailCampaign[]
  emailOptOuts           EmailOptOut[]
}

// Kiracının platforma yaptığı abonelik ödemeleri (iyzico veya manuel)
model SubscriptionPayment {
  id                Int      @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  planCode          String
  billingCycle      String
  amount            Float
  status            String   @default("SUCCESS") // SUCCESS, FAILED
  method            String // IYZICO, MANUAL
  reference         String?  @unique // iyzico sipariş referansı / dekont no
  periodStart       DateTime
  periodEnd         DateTime
  note              String?
  createdAt         DateTime @default(now())
  // Platformun müşteriye kestiği fatura (PARASUT_* ortam değişkenleri tanımlıysa otomatik)
  invoiceStatus     String? // PENDING, ISSUED, FAILED
  invoiceNumber     String?
  invoiceExternalId String?
  invoiceError      String?

  @@index([tenantId])
}

// ─── Bayi deneyimi ───────────────────────────────────────────────────────────

// Ana ürüne tanımlanan varyant özelliği (örn. "Gramaj", "Ambalaj Türü", "Uzunluk")
model ProductOption {
  id        Int     @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)

  values ProductOptionValue[]

  @@index([tenantId])
  @@index([productId])
}

// Özelliğin seçenekleri (örn. Gramaj → "500 g", "1 kg", "5 kg")
model ProductOptionValue {
  id        Int           @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  optionId  Int
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     String
  sortOrder Int           @default(0)

  variants ProductVariantValue[]

  @@index([tenantId])
  @@index([optionId])
}

// Bir varyantın (alt ürün) her özellik için seçtiği değer
model ProductVariantValue {
  id            Int                @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  variantId     Int
  variant       Product            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId Int
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@index([tenantId])
}

// Özel / kademeli fiyat. companyId → o bayiye, dealerGroup → o gruba, ikisi de boş → herkese.
// minQty: bu miktar ve üzerinde geçerli (kademeli fiyat). Fiyat ürünün döviz cinsinden, KDV hariç nettir.
model SpecialPrice {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId   Int?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealerGroup String?
  minQty      Int       @default(1)
  price       Float
  validFrom   DateTime? // Kampanya / sözleşme fiyatı başlangıcı (boşsa hemen geçerli)
  validUntil  DateTime? // Bitişi (boşsa süresiz)
  createdAt   DateTime  @default(now())

  @@index([tenantId, productId])
}

// Kısmi sevkiyat: onaylanan siparişin kargoya verilen her parçası (items: [{ orderItemId, quantity }])
model OrderShipment {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  orderId        Int
  order          Order    @relation(fields: [orderId], references: [id])
  trackingNumber String?
  cargoCompany   String?
  items          Json
  createdById    Int?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([orderId])
}

// Bayi hedefi ve ciro primi: dönem içindeki onaylı satış (KDV hariç) hedefe ulaşırsa bonusRate kadarı cariye alacak yazılır
model DealerTarget {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id])
  name           String? // "2026 4. çeyrek"
  periodStart    DateTime
  periodEnd      DateTime
  targetAmount   Float // KDV hariç TL
  bonusRate      Float // Hedefe ulaşınca satışın yüzde kaçı prim olarak cariye yazılır
  status         String    @default("OPEN") // OPEN, PAID (prim cariye yazıldı), CLOSED (hedef tutmadı / kapatıldı)
  achievedAmount Float? // Kapanıştaki gerçekleşen
  paidAmount     Float?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([companyId])
}

// Kupon / kampanya kodu
model Coupon {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  code        String
  description String?
  type        String // PERCENT, AMOUNT
  value       Float
  minSubtotal Float     @default(0) // KDV hariç minimum sepet
  startsAt    DateTime?
  endsAt      DateTime?
  maxUses     Int? // Toplam kullanım sınırı
  usedCount   Int       @default(0)
  companyId   Int? // Sadece bu bayi
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealerGroup String? // Sadece bu grup
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([tenantId, code])
}

// Uyumlu ürün çifti (ürün veya varyant düzeyinde). Teklif hazırlarken "uyumlu kapak" gibi taleplerde kullanılır.
model ProductCompatibility {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  productId    Int
  product      Product  @relation("CompatFrom", fields: [productId], references: [id], onDelete: Cascade)
  compatibleId Int
  compatible   Product  @relation("CompatTo", fields: [compatibleId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([productId, compatibleId])
  @@index([tenantId])
  @@index([compatibleId])
}

// Teklif. İki kaynaktan doğar: bayinin portaldan istediği teklif (DEALER) veya personelin hazırladığı teklif (STAFF).
// Durum: PENDING (bayi talebi, fiyat bekliyor) · DRAFT · PENDING_APPROVAL · QUOTED (gönderildi) · ACCEPTED · REJECTED · EXPIRED · CANCELLED
// Gönderilen her sürüm QuoteRevision'da değişmez kopya olarak saklanır; müşteri yalnızca o kopyayı görür ve kabul eder.
model QuoteRequest {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  number          Int // Firma içinde benzersiz teklif numarası (TK-{number})
  title           String?
  source          String    @default("DEALER") // DEALER, STAFF
  companyId       Int
  company         Company   @relation(fields: [companyId], references: [id])
  userId          Int // Talebi açan bayi kullanıcısı ya da teklifi oluşturan personel
  user            User      @relation(fields: [userId], references: [id])
  preparedById    Int? // Teklifi hazırlayan / fiyatlandıran personel
  preparedBy      User?     @relation("QuotePreparer", fields: [preparedById], references: [id])
  status          String    @default("PENDING")
  note            String? // Bayinin talep notu
  adminNote       String? // Müşteriye görünen açıklama
  internalNote    String? // Yalnızca personel görür
  paymentTerms    String?
  deliveryTerms   String?
  currency        String    @default("TRY")
  validUntil      DateTime?
  // Çalışma kopyasının toplamları (liste ve filtre için; gönderilen sürümün tutarı QuoteRevision'dadır)
  subtotal        Float?
  vatAmount       Float?
  totalAmount     Float?
  revision        Int       @default(1) // Üzerinde çalışılan sürüm
  sentRevision    Int? // Müşteriye gönderilen son sürüm (kabul yalnızca bu sürüm için ve QUOTED durumunda yapılabilir)
  sentAt          DateTime?
  // Yönetici onayı (iskonto sınırı aşıldığında / maliyet altı fiyatta)
  approvalReasons Json?
  approvedById    Int?
  approvedByName  String?
  approvedAt      DateTime?
  approvalNote    String?
  // Yapay zekâ ile hazırlandıysa: talep metni ve iç değerlendirme (müşteriye gösterilmez)
  aiRequest       String?
  aiMeta          Json?
  // Paylaşım bağlantısı: anahtarın özeti (doğrulama) ve şifreli hali (bağlantıyı tekrar kopyalayabilmek için)
  shareTokenHash  String?   @unique
  shareTokenEnc   String?
  emailedAt       DateTime? // Yalnızca e-posta gerçekten gönderildiyse dolar
  // Müşterinin son yanıtı (kabul / ret / revizyon talebi)
  responseType    String? // ACCEPTED, REJECTED, REVISION_REQUESTED
  responseNote    String?
  responseBy      String?
  responseVia     String? // PORTAL, LINK
  respondedAt     DateTime?
  convertedAt     DateTime? // Siparişe dönüştürme kilidi (çift sipariş engeli)
  orderId         Int?      @unique
  order           Order?    @relation(fields: [orderId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items     QuoteRequestItem[]
  revisions QuoteRevision[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
}

model QuoteRequestItem {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  quoteRequestId Int
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  productId      Int? // Eşleşmeyen kalemde boş (gönderilmeden önce çözülmeli ya da silinmeli)
  product        Product?     @relation(fields: [productId], references: [id])
  quantity       Int // Ürünün satış biriminde
  variantLabel   String?
  sortOrder      Int          @default(0)
  quotedPrice    Float? // Net birim fiyat (TL, KDV hariç, teklif iskontosu sonrası)
  basePrice      Float? // Müşteriye sistemde geçerli birim fiyat (bayi iskontoları / özel fiyat dahil)
  discountRate   Float        @default(0) // Teklif iskontosu (%)
  manualPrice    Boolean      @default(false) // Birim fiyat elle girildi
  vatRate        Float?
  // Talepten eşleştirme bilgisi (yalnızca personel görür)
  requestText    String? // Müşterinin yazdığı ihtiyaç satırı
  matchStatus    String       @default("MANUAL") // MANUAL, MATCHED, REVIEW (kullanıcı teyidi gerekir), UNMATCHED
  matchReason    String?
  warnings       Json? // ["..."]
  alternatives   Json? // [productId, ...]

  @@index([tenantId])
}

// Müşteriye gönderilen teklif sürümünün değişmez kopyası (ürün adları, fiyatlar, KDV, koşullar, toplamlar)
model QuoteRevision {
  id             Int          @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  quoteRequestId Int
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  revision       Int
  snapshot       Json
  totalAmount    Float
  sentById       Int?
  sentByName     String?
  createdAt      DateTime     @default(now())

  @@unique([quoteRequestId, revision])
  @@index([tenantId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([tenantId])
}

// Kaydedilmiş sepet (sipariş şablonu)
model OrderTemplate {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  name      String
  items     Json // [{ sku, quantity }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── Entegrasyon (ERP) ───────────────────────────────────────────────────────

// Firmanın ERP / entegratör için ürettiği API anahtarı. Anahtarın kendisi saklanmaz, sadece özeti (hash).
model ApiKey {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  prefix     String // Anahtarın ilk karakterleri (listede tanımak için)
  keyHash    String    @unique
  isTest     Boolean   @default(false) // Test anahtarı: yazma istekleri doğrulanır ama kaydedilmez
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

// Olay bildirimi: sipariş oluştu / durum değişti, bayi oluştu vb. → firmanın verdiği adrese POST
model Webhook {
  id         Int               @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  url        String
  events     Json // ["order.created", "order.updated", ...]
  secret     String // İmza (X-Webhook-Signature, HMAC-SHA256)
  isActive   Boolean           @default(true)
  lastStatus Int?
  lastError  String?
  lastAt     DateTime?
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([tenantId])
}

// Webhook gönderim kaydı ve kalıcı yeniden deneme kuyruğu
model WebhookDelivery {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  webhookId      Int
  webhook        Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  body           String // imzalanan gövde (yeniden denemede aynısı gönderilir)
  status         String    @default("PENDING") // PENDING, SENDING, SUCCESS, FAILED
  attempts       Int       @default(0)
  lastStatusCode Int?
  lastError      String?
  nextAttemptAt  DateTime  @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId])
  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

// ─── Platform: işlem kaydı, duyurular, destek ─────────────────────────────────

// Kim, ne zaman, neyi değiştirdi. tenantId boşsa platform işlemidir.
// Firma silinse de kayıt kalsın diye kiracıya yabancı anahtarla bağlı değildir.
model AuditLog {
  id             Int      @id @default(autoincrement())
  tenantId       Int?
  actorType      String // USER, PLATFORM, API_KEY, SYSTEM
  actorId        Int?
  actorName      String?
  impersonatedBy String? // Destek oturumunda platform yöneticisinin adı
  action         String // örn. "Sipariş onaylandı"
  method         String?
  path           String?
  entity         String?
  entityId       String?
  details        Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

// Platformdan firma yöneticilerine duyuru (bakım, yeni özellik vb.)
model Announcement {
  id        Int       @id @default(autoincrement())
  title     String
  body      String
  level     String    @default("INFO") // INFO, WARNING, MAINTENANCE
  planCode  String? // Sadece bu paketteki firmalar (boş = herkes)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

// Firmanın platforma açtığı destek talebi
model SupportTicket {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  subject         String
  priority        String    @default("NORMAL") // NORMAL, HIGH
  category        String    @default("OTHER") // TECHNICAL, BILLING, FEATURE, USAGE, OTHER
  context         Json? // Talep açılırken otomatik eklenen bilgi: son sayfa, tarayıcı, paket…
  dueAt           DateTime? // Hedef yanıt zamanı (SLA); platform yanıtlayınca boşalır
  firstResponseAt DateTime? // İlk platform yanıtı (ölçüm için)
  status          String    @default("OPEN") // OPEN (platform yanıtı bekliyor), ANSWERED, CLOSED
  rating          Int? // Kapanınca firmanın verdiği memnuniyet puanı (1-5)
  ratingComment   String?
  ratedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages SupportMessage[]

  @@index([tenantId])
}

// Yardım merkezi yazısı (platform yönetir, tüm firmalar görür). Destek talebi açmadan önce önerilir.
model HelpArticle {
  id          Int      @id @default(autoincrement())
  category    String   @default("USAGE") // TECHNICAL, BILLING, FEATURE, USAGE, OTHER (destek kategorileriyle aynı)
  title       String
  summary     String   @default("")
  body        String
  keywords    String   @default("") // Aramada eşleşsin diye ek kelimeler (virgülle)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  views       Int      @default(0)
  helpfulYes  Int      @default(0)
  helpfulNo   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, category])
}

model SupportMessage {
  id          Int           @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  ticketId    Int
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  String // TENANT, PLATFORM
  authorName  String
  attachments Json? // [{ url, name, type, size }]
  body        String
  createdAt   DateTime      @default(now())

  @@index([tenantId])
}

// Hata izleme: aynı hata (parmak izi) tek kayıtta toplanır ve sayılır. Firma silinse de kayıt kalır (FK yok).
model ErrorLog {
  id          Int       @id @default(autoincrement())
  fingerprint String    @unique
  source      String // SERVER, CLIENT
  message     String
  stack       String?
  method      String?
  path        String?
  statusCode  Int?
  tenantId    Int?
  userId      Int?
  userAgent   String?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([lastSeenAt])
  @@index([resolvedAt])
}

// ─── İzleme (platform) ───────────────────────────────────────────────────────

// API istek metrikleri: dakika + uç bazında toplu (her istek ayrı saklanmaz). 14 gün tutulur.
model RequestMetric {
  id           Int      @id @default(autoincrement())
  minute       DateTime // dakika başı
  method       String
  route        String // /api/orders/:id gibi kalıp
  count        Int      @default(0)
  errors       Int      @default(0) // 5xx
  clientErrors Int      @default(0) // 4xx
  totalMs      Int      @default(0)
  maxMs        Int      @default(0)
  slow         Int      @default(0) // 1 sn üzeri

  @@unique([minute, method, route])
  @@index([minute])
}

// Yavaş istek örnekleri (1 sn üzeri). 7 gün tutulur.
model SlowRequest {
  id         Int      @id @default(autoincrement())
  method     String
  route      String
  path       String
  statusCode Int
  ms         Int
  tenantId   Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Arka plan işi çalışmaları (zamanlanmış hatırlatmalar, kargo senkronu, webhook kuyruğu, temizlik…). 14 gün tutulur.
model JobRun {
  id         Int       @id @default(autoincrement())
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  durationMs Int?
  error      String?

  @@index([name, startedAt])
  @@index([startedAt])
}

// Dış servis çağrıları (iyzico, PayTR, Paraşüt, Yurtiçi, TCMB, yapay zekâ, e-posta). 14 gün tutulur.
model ExternalCall {
  id         Int      @id @default(autoincrement())
  service    String
  operation  String?
  ok         Boolean
  statusCode Int?
  durationMs Int
  error      String?
  tenantId   Int?
  createdAt  DateTime @default(now())

  @@index([service, createdAt])
  @@index([createdAt])
}

// ERP / entegrasyon API istekleri (API anahtarıyla gelen). 30 gün tutulur.
model ApiRequestLog {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  apiKeyId   Int?
  apiKeyName String?
  method     String
  path       String
  statusCode Int
  durationMs Int
  error      String?
  isTest     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

// ─── Tanıtım sitesi, canlı sohbet ve satış talepleri (platform düzeyi, kiracıya ait değil) ───

// Site ayarları: firma bilgileri, yasal metinler, chatbot, demo, reklam ölçümü (key → JSON)
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Satış talebi: tanıtım sayfasındaki form veya chatbot konuşmasından
model Lead {
  id            Int          @id @default(autoincrement())
  source        String // FORM, CHAT
  name          String       @default("")
  company       String       @default("")
  phone         String       @default("")
  email         String       @default("")
  message       String       @default("")
  status        String       @default("NEW") // NEW, CONTACTED, WON, LOST
  note          String       @default("")
  utm           Json?
  chatSessionId String?      @unique
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
}

// Ziyaretçi sohbeti. id tahmin edilemez rastgele değerdir ve ziyaretçinin oturum anahtarı olarak kullanılır.
model ChatSession {
  id            String        @id
  status        String        @default("BOT") // BOT (otomatik), HUMAN (temsilci devraldı), CLOSED
  needsHuman    Boolean       @default(false) // ziyaretçi temsilci istedi / bot yanıtlayamadı
  unread        Boolean       @default(false) // platform panelinde okunmamış ziyaretçi mesajı
  pageUrl       String        @default("")
  utm           Json?
  ip            String        @default("")
  userMessages  Int           @default(0)
  createdAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]
  lead          Lead?

  @@index([lastMessageAt])
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // USER, BOT, AGENT
  text      String
  createdAt DateTime    @default(now())

  @@index([sessionId, id])
}

// Firmanın müşteri adayı: Instagram / WhatsApp reklamından yazan, talep formunu dolduran ya da elle eklenen kişi
model CustomerLead {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  phone       String   @default("")
  email       String   @default("")
  city        String   @default("")
  source      String   @default("OTHER") // INSTAGRAM, WHATSAPP, FACEBOOK, FORM, PHONE, OTHER
  campaign    String   @default("") // Reklam / kampanya adı
  request     String   @default("") // Ne istedi (ürün, adet, mesaj)
  status      String   @default("NEW") // NEW, CONTACTED, ORDERED, LOST
  note        String   @default("")
  viaForm     Boolean  @default(false) // Kişi talep formunu kendisi doldurdu
  answers     Json? // Formdaki ek soruların yanıtları: [{ label, value }] (soru sonradan değişse de gönderildiği hâliyle)
  utm         Json?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, phone])
}

// Firmanın WhatsApp Business (Cloud API) bağlantısı. Gizli bilgiler şifreli saklanır (secretBox).
model WhatsappChannel {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @unique
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  phoneNumberId  String    @unique // Meta'daki telefon numarası kimliği (gelen mesaj bu kimlikle eşleşir)
  wabaId         String    @default("")
  displayPhone   String    @default("")
  verifiedName   String    @default("")
  accessTokenEnc String
  appSecretEnc   String // Meta'dan gelen isteklerin imzasını doğrulamak için
  webhookKey     String    @unique // Firmaya özel webhook adresi: /api/whatsapp/webhook/<webhookKey>
  verifyToken    String // Meta webhook doğrulama anahtarı
  aiEnabled      Boolean   @default(true)
  knowledge      String    @default("") // Yapay zekânın kullanacağı firma bilgileri (kargo, ödeme, saatler…)
  handoffMessage String    @default("")
  lastWebhookAt  DateTime?
  lastError      String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// WhatsApp konuşması (müşteri numarası başına bir tane)
model WaConversation {
  id             Int         @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  waId           String // Müşterinin WhatsApp numarası (90532…)
  name           String      @default("") // WhatsApp profil adı
  status         String      @default("BOT") // BOT (yapay zekâ cevaplar), HUMAN (ekip devraldı), CLOSED
  needsHuman     Boolean     @default(false) // Ekip yanıtı bekleniyor
  unread         Int         @default(0)
  lastMessageAt  DateTime    @default(now())
  lastInboundAt  DateTime? // 24 saatlik serbest mesaj penceresi buna göre
  lastPreview    String      @default("")
  customerLeadId Int?
  createdAt      DateTime    @default(now())
  messages       WaMessage[]

  @@unique([tenantId, waId])
  @@index([tenantId, lastMessageAt])
}

model WaMessage {
  id             Int            @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  conversationId Int
  conversation   WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // IN, OUT
  author         String // CUSTOMER, AI, AGENT, SYSTEM
  body           String
  waMessageId    String?        @unique
  status         String         @default("") // sent, delivered, read, failed
  error          String         @default("")
  agentId        Int?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// Zamanlanmış dönemsel rapor (haftalık / aylık): oluşturulduğu andaki sonuç saklanır, panelden açılır ve indirilir
model PeriodicReport {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  period    String // WEEKLY, MONTHLY
  from      DateTime
  to        DateTime
  data      Json
  createdAt DateTime @default(now())

  @@unique([tenantId, period, from])
  @@index([tenantId, createdAt])
}

// Gelir-gider: cariye bağlı olmayan giderler (kira, maaş, fatura…) ve satış dışı gelirler. Tutar TL, KDV dahil.
model CashEntry {
  id            Int            @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  type          String // IN: gelir, OUT: gider
  category      String
  amount        Float
  date          DateTime
  method        String? // CASH, BANK, CARD
  vatRate       Float          @default(0) // Tutarın içindeki KDV oranı (%)
  description   String?
  // Fiş / fatura (uploads/private/cash, yalnızca yetkiyle indirilir)
  fileName      String?
  storedName    String?
  mimeType      String?
  recurringId   Int? // Düzenli gider/gelirden otomatik oluştuysa
  // Personel ödemesinden oluştuysa kaynağı ("STAFF_PAY:12": StaffPayment). Tekil: aynı ödeme iki kez
  // ödenemez. Bu kayıtlar gelir-giderden değiştirilmez, Personel Yönetimi'nden geri alınır.
  sourceRef     String?        @unique
  recurring     CashRecurring? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  createdByName String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, date])
}

// Düzenli gelir / gider (kira, maaş…): her ay seçilen günde otomatik kayıt oluşur
model CashRecurring {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  type          String // IN, OUT
  category      String
  amount        Float
  vatRate       Float       @default(0)
  method        String?
  description   String?
  dayOfMonth    Int // 1–28
  isActive      Boolean     @default(true)
  lastRunMonth  String? // 'YYYY-MM': bu ayın kaydı oluşturuldu
  createdByName String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  entries       CashEntry[]

  @@index([tenantId])
}

// Abonelik için havale / EFT bildirimi: firma "ödemeyi yaptım" der, platform yöneticisi onaylayınca abonelik uzar
model TransferNotice {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  planCode      String
  billingCycle  String
  amount        Float
  senderName    String
  note          String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  paymentId     Int? // Onaylanınca oluşan SubscriptionPayment
  resolvedAt    DateTime?
  resolvedBy    String?
  rejectReason  String?
  createdByName String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, status])
}

// ─── Personel yönetimi (firma bazında açılır: hr_enabled) ───────────────────
// Bordro, SGK ve özlük dosyası kapsam dışıdır. Onay "Personel" (HR), ödeme "Finans" yetkisiyle yapılır.

// Personel kartı. Sistem hesabı (yönetici / plasiyer) bağlanırsa personel kendi taleplerini açar ve görür.
model Employee {
  id         Int                 @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  userId     Int?                @unique // Bayi hesabı bağlanamaz
  user       User?               @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  name       String
  email      String?
  phone      String?
  department String?
  title      String? // Görev
  hireDate   DateTime?
  isActive   Boolean             @default(true)
  // Yöneticisi (departman yöneticisi): Personel yetkisi olmadan da bu kişinin izin ve masraf / avans taleplerine karar verir
  managerId  Int?
  manager    Employee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Employee[]          @relation("EmployeeManager")
  // Yıllık izin: firmanın verdiği gün (yıl başına); boşsa ya da yasal süreden azsa yasal süre (14 / 20 / 26)
  annualLeaveDays Int?
  // Devir: sisteme geçişte "leaveCarryDate itibarıyla kalan yıllık izin leaveCarryDays gün"
  leaveCarryDays  Float?
  leaveCarryDate  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  leaves     LeaveRequest[]
  claims     StaffClaim[]
  targets    StaffTarget[]
  payments   StaffPayment[]

  @@index([tenantId])
  @@index([managerId])
}

model LeaveRequest {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          String // ANNUAL (yıllık), EXCUSE (mazeret), SICK (hastalık / rapor), UNPAID (ücretsiz), OTHER
  startDate     DateTime
  endDate       DateTime
  days          Float // İş günü (hafta sonu ve resmî tatil sayılmaz; yarım gün 0,5)
  half          String? // Yarım gün (yalnızca tek günlük izinde): AM sabah, PM öğleden sonra
  note          String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  decidedById   Int?
  decidedByName String?
  decidedAt     DateTime?
  rejectReason  String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([employeeId])
}

// Masraf (fiş / fatura ekiyle) ve avans talebi. Onay ile ödeme ayrıdır: onaylanan talep ödenmiş sayılmaz.
model StaffClaim {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          String // EXPENSE (masraf), ADVANCE (avans)
  amount        Float
  date          DateTime // Masrafın yapıldığı / avansın istendiği gün
  description   String
  fileName      String?
  storedName    String? // uploads/private/hr (yalnızca sahibi ve yetkililer indirir)
  mimeType      String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  decidedById   Int?
  decidedByName String?
  decidedAt     DateTime?
  rejectReason  String?
  // Ödeme kısmi olabilir (StaffPayment): paidAmount ödenen + avanstan mahsup edilen; tamamı ödenince paidAt
  paidAmount    Float     @default(0)
  paidAt        DateTime?
  // Avans: kapanan tutar (masraf / prim mahsubu, nakit iade, maaştan kesinti). Açık avans = paidAmount − settledAmount
  settledAmount Float     @default(0)
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      StaffPayment[] @relation("ClaimPayments")
  settlements   StaffPayment[] @relation("AdvanceSettlements")

  @@index([tenantId, status])
  @@index([employeeId])
}

// Aylık satış hedefi ve prim. Gerçekleşen siparişlerden (ya da tahsilattan) hesaplanır; kapanışta prim sabitlenir,
// ödemesi ayrıca yapılır (hesaplanan ve ödenen prim ayrı tutulur).
model StaffTarget {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  employeeId     Int
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period         String // 'YYYY-MM'
  targetAmount   Float // TL (satışta KDV hariç)
  bonusRate      Float // Hedef tutarsa gerçekleşenin yüzde kaçı prim
  basis          String    @default("SALES") // SALES: onaylanan satış − iadeler, COLLECTION: tahsilat
  status         String    @default("OPEN") // OPEN, CLOSED
  achievedAmount Float? // Kapanıştaki gerçekleşen
  bonusAmount    Float? // Kapanışta hesaplanan prim
  closedAt       DateTime?
  closedByName   String?
  paidAmount     Float     @default(0) // Ödenen + avanstan mahsup (kısmi olabilir)
  paidAt         DateTime? // Tamamı ödendiğinde
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       StaffPayment[]

  @@unique([employeeId, period])
  @@index([tenantId, period])
}

// Firma içi duyuru (platformun firmalara duyurusundan ayrı): tüm personele ya da seçilen departmanlara
model StaffAnnouncement {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  title         String
  body          String
  departments   String[] // Boş = tüm personel
  createdById   Int?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Personel ödemeleri ve avans kapanışları (kısmi ödeme: bir talebe / prime birden çok kayıt).
//  PAYOUT : firmadan personele ödeme (masraf, avans, prim) → gelir-giderde gider
//  OFFSET : masrafın ya da primin açık avanstan düşülmesi (nakit çıkmaz; avans kapanır)
//  REFUND : personelin kullanmadığı avansı iadesi → gelir-giderde gelir
//  PAYROLL: avansın maaştan kesilmesi (bordro sistem dışında; nakit kaydı açılmaz)
model StaffPayment {
  id            Int          @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  employeeId    Int
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind          String
  amount        Float
  date          DateTime
  method        String? // CASH, BANK, CARD (PAYOUT, REFUND)
  claimId       Int? // Ödenen ya da avanstan mahsup edilen masraf / avans
  claim         StaffClaim?  @relation("ClaimPayments", fields: [claimId], references: [id], onDelete: Cascade)
  targetId      Int? // Ödenen ya da avanstan mahsup edilen prim
  target        StaffTarget? @relation(fields: [targetId], references: [id], onDelete: Cascade)
  advanceId     Int? // Kapanan avans (OFFSET, REFUND, PAYROLL)
  advance       StaffClaim?  @relation("AdvanceSettlements", fields: [advanceId], references: [id], onDelete: Cascade)
  cashEntryId   Int?         @unique // Gelir-gider kaydı (PAYOUT, REFUND); kaynak anahtarı STAFF_PAY:<id>
  note          String?
  createdById   Int?
  createdByName String?
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([claimId])
  @@index([targetId])
  @@index([advanceId])
}

// Toplu SMS (Müşteriler → Toplu SMS): seçilen bayi, müşteri carisi ve müşteri adaylarına Netgsm ile gönderim.
// INFO: bilgilendirme; COMMERCIAL: ticari (İYS süzgeçli, sonuna firmanın ret metni eklenir)
model SmsCampaign {
  id          Int                    @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  createdById Int?
  createdBy   User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  kind        String // INFO, COMMERCIAL
  text        String // Şablon ({ad}, {yetkili}, {bakiye} doldurulmadan)
  total       Int // Alıcı numara sayısı
  sent        Int                    @default(0)
  failed      Int                    @default(0)
  parts       Int                    @default(1) // En uzun mesajın tahmini SMS boyu
  error       String?
  createdAt   DateTime               @default(now())
  recipients  SmsCampaignRecipient[]

  @@index([tenantId, createdAt])
}

model SmsCampaignRecipient {
  id         Int         @id @default(autoincrement())
  tenantId   Int
  campaignId Int
  campaign   SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  source     String // DEALER, CUSTOMER, LEAD
  sourceId   Int
  name       String
  phone      String
  ok         Boolean
  error      String?

  @@index([campaignId])
}

// Toplu e-posta (Müşteriler → Toplu E-posta): arka planda, hızı ve günlük sınırı ayarlı gönderilir; sunucu yeniden
// başlarsa bekleyen alıcılardan devam edilir. Her e-postada abonelikten çıkma bağlantısı vardır.
model MailCampaign {
  id          Int                     @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  createdById Int?
  createdBy   User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  kind        String // INFO (bilgilendirme), COMMERCIAL (ticari)
  subject     String
  body        String // Şablon ({ad}, {yetkili}, {bakiye} doldurulmadan), düz metin
  total       Int
  sent        Int                     @default(0)
  failed      Int                     @default(0)
  status      String                  @default("SENDING") // SENDING, DONE
  error       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt // Gönderim sürerken her partide güncellenir (yarıda kalanı bulmak için)
  finishedAt  DateTime?
  recipients  MailCampaignRecipient[]

  @@index([tenantId, createdAt])
  @@index([status, updatedAt])
}

model MailCampaignRecipient {
  id         Int          @id @default(autoincrement())
  tenantId   Int
  campaignId Int
  campaign   MailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  source     String // DEALER, CUSTOMER, LEAD
  sourceId   Int
  name       String
  email      String
  status     String       @default("PENDING") // PENDING, SENDING, SENT, FAILED
  error      String?
  sentAt     DateTime?
  updatedAt  DateTime     @updatedAt

  @@index([campaignId, status])
}

// Toplu e-postadan çıkanlar: bu adrese firmanın toplu e-postası bir daha gitmez (bildirim e-postaları ayrı)
model EmailOptOut {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
}
