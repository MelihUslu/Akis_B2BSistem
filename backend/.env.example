# PostgreSQL (docker-compose içinde DATABASE_URL otomatik verilir; yerelde çalıştırırken kullanılır)
DATABASE_URL=postgresql://akis:akis_dev_password@localhost:5433/akis_b2b
PORT=5001

# ZORUNLU: uzun ve rastgele bir değer kullanın (örn: openssl rand -base64 48)
JWT_SECRET=
# Firmaların sanal POS gizli anahtarlarını şifreler. Canlıda mutlaka ayrı ve sabit bir değer verin
# (boşsa JWT_SECRET'tan türetilir; JWT_SECRET değişirse kayıtlı POS anahtarları çözülemez)
ENCRYPTION_KEY=

# ─── Alan adı yapısı ───────────────────────────────────────────────
# Kiracılar <slug>.ROOT_DOMAIN, platform paneli platform.ROOT_DOMAIN adresinde çalışır.
# Geliştirme: localhost  →  akis.localhost:5173, platform.localhost:5173
# Canlı:      akisb2b.com → akis.akisb2b.com (DNS'te *.akisb2b.com wildcard kaydı gerekir)
ROOT_DOMAIN=localhost
FRONTEND_PROTOCOL=http
FRONTEND_PORT=5173
# Backend'in dışarıdan erişilen adresi (iyzico geri dönüşü ve dosya linkleri için)
API_PUBLIC_URL=http://localhost:5001
PUBLIC_URL=

# ─── Platform sahibi (ilk kurulumda seed ile oluşturulur) ───────────
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Yöneticisi
PLATFORM_NAME=Akis B2B
# Yeni kayıt / ödeme hatası bildirimleri bu adrese gider (boşsa gönderilmez)
PLATFORM_ALERT_EMAIL=
# İzleme: günlük özet e-postası (08:00), son 10 dk'da bu kadar sunucu hatası olursa uyarı, isteğe bağlı Sentry (npm install @sentry/node)
DAILY_DIGEST=true
DIGEST_HOUR=8
ALERT_ERROR_SPIKE=30
SENTRY_DSN=
# true ise ilk kurulumda "demo" adlı örnek bir kiracı oluşturulur
SEED_DEMO=false

# ─── iyzico abonelik (boşsa online ödeme kapalı, ödemeler platform panelinden manuel işlenir) ───
# Sandbox anahtarları: https://sandbox-merchant.iyzipay.com  →  Ayarlar > Firma Ayarları
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ─── SMTP (boşsa mailler gönderilmez, geliştirme ortamında içerik konsola yazılır) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# İsteğe bağlı: istek sınırlayıcı sayaçları için Redis (birden çok sunucuda). Boşsa bellek içi sayaç.
REDIS_URL=
# Özel alan adı kullanan firmaların CNAME kaydını yönlendireceği hedef (varsayılan custom.ROOT_DOMAIN)
CUSTOM_DOMAIN_TARGET=
# 'true' ise kapatılan hesapların verisi 30 gün sonra otomatik silinir
AUTO_PURGE_CLOSED=false

# ─── Platformun kendi faturaları (abonelik ödemeleri) için Paraşüt hesabı; boşsa fatura kesilmez ───
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=
# Paket fiyatlarındaki KDV oranı (fiyatlar KDV dahildir)
SUBSCRIPTION_VAT_RATE=20
# Saat dilimi: tarih filtreleri ve raporlar bu saate göre (varsayılan Europe/Istanbul)
TZ=Europe/Istanbul

# Web Push (mobil uygulama bildirimleri). Boşsa push kapalıdır. Üretmek için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@ornek.com

# Google ile giriş (isteğe bağlı). Google Cloud Console → OAuth istemci kimliği (Web uygulaması);
# yönlendirme URI'si: <API_PUBLIC_URL>/api/public/google/callback  (geliştirmede http://localhost:5001/api/public/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yapay zekâ destekli teklif hazırlama (anahtar yalnızca sunucuda tutulur, arayüze gönderilmez).
# Tanımlı değilse yapay zekâ butonu kapalıdır; teklifler manuel hazırlanır.
# AI_PROVIDER=mock yalnızca geliştirme/test içindir (örnek eşleştirme); NODE_ENV=production iken çalışmaz.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_MS=60000
AI_DAILY_LIMIT=200
