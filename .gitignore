# Bağımlılıklar ve build çıktıları
node_modules/
node_modules */
dist/

# Ortam değişkenleri (örnekleri .env.example dosyalarındadır)
.env
.env.*
!.env.example

# SQLite veritabanları
*.db
*.db-journal

# Kullanıcı yüklemeleri
backend/uploads/images/*
!backend/uploads/images/.gitkeep
backend/uploads/support/*
# Cari belgeleri (vergi levhası, sözleşme…) — kişisel / ticari veri
backend/uploads/private/

# Sistem / editör
.DS_Store
*.log

# Yedekler (asla depoya girmez)
backups/

# UAT: oturumlar, derleme, rapor ve ekran kayıtları
uat/.data/
